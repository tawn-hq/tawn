#!/usr/bin/env bash
# tawn commit-msg hook — enforces Conventional Commits.
# Enable once per clone:  git config core.hooksPath .githooks
# Format:  <type>(<scope>)?: <subject ≤72 chars, imperative, no trailing period>
# Types:   feat fix docs style refactor perf test build ci chore revert

msg_file="$1"
subject="$(head -n1 "$msg_file")"

# ignore merges, reverts generated by git, and fixup/squash autosquash lines
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?!?: [a-z].{0,69}$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "✗ commit message rejected by .githooks/commit-msg" >&2
  echo "  subject: '$subject'" >&2
  echo "  required: <type>(<scope>)?: <lowercase subject, ≤72 chars>" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  examples:" >&2
  echo "    feat: add deny-all Grants model" >&2
  echo "    fix(fs): resolve symlinks before grant check" >&2
  exit 1
fi

if printf '%s' "$subject" | grep -Eq '\.$'; then
  echo "✗ commit subject must not end with a period" >&2
  exit 1
fi

# body (if present) must be separated from subject by a blank line
if [ "$(sed -n '2p' "$msg_file")" != "" ] && [ -n "$(sed -n '2p' "$msg_file")" ]; then
  case "$(sed -n '2p' "$msg_file")" in
    \#*) ;;  # comment line, fine
    *)
      echo "✗ leave a blank line between subject and body" >&2
      exit 1
      ;;
  esac
fi

exit 0
